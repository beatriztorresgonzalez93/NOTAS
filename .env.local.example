# Cadena de conexión de MongoDB (Atlas o local)
# Ejemplo local: mongodb://127.0.0.1:27017/notas
#
# Atlas (copia la URI desde Connect → Drivers → Node.js):
# Debe terminar en /notas (nombre de la base de datos), NO "notas" en el host.
# Correcto:  mongodb+srv://usuario:pass@cluster0.xxxxx.mongodb.net/notas?retryWrites=true&w=majority
# Incorrecto: mongodb+srv://usuario:pass@notas.xxxxx.mongodb.net/?appName=NOTAS
#
# Si ves "querySrv ECONNREFUSED", en Atlas usa la cadena estándar (mongodb:// sin srv)
# o cambia el DNS de Windows a 8.8.8.8 / 1.1.1.1
MONGODB_URI=
